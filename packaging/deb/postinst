#!/bin/sh
# Let every user trace with raw sockets, which UDP probes and MPLS labels need on
# Linux, as Debian's mtr does for mtr-packet. mtr-ng opens its raw sockets first
# and gives the capability up before doing anything else. Without it, ICMP still
# works for users whose group net.ipv4.ping_group_range allows ping sockets.
set -e

if [ "$1" = configure ]; then
    if ! command -v setcap >/dev/null 2>&1 || ! setcap cap_net_raw+ep /usr/bin/mtr-ng; then
        echo "mtr-ng: could not give /usr/bin/mtr-ng CAP_NET_RAW, so UDP probes and" >&2
        echo "MPLS labels need sudo. To grant it: apt install libcap2-bin," >&2
        echo "then: setcap cap_net_raw+ep /usr/bin/mtr-ng" >&2
    fi
fi

exit 0
